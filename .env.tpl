# Copy to .env in the directory you run jcli from, then uncomment and fill in the
# settings you use. Leave unused settings commented out: a key present in .env wins
# over config.toml, even when it is blank.
#
# Precedence per setting: process environment, then .env, then
# $XDG_CONFIG_HOME/jcli/config.toml (or ~/.config/jcli/config.toml).

# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your-api-token

# Only needed for `jcli xray ...` commands.
# XRAY_BASE_URL=https://xray.example.com
# XRAY_CLIENT_ID=your-client-id
# XRAY_CLIENT_SECRET=your-client-secret
